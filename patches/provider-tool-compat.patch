+export function extractJourneyToolCalls(data){
+ const message=data?.choices?.[0]?.message;
+ const calls=message?.tool_calls;
+ if(Array.isArray(calls)) return calls.map(call=>({name:call?.function?.name,arguments:parseArguments(call?.function?.arguments)}));
+ // Some OpenAI-compatible gateways expose a single structured tool call as a content block.
+ if(Array.isArray(message?.content)) return message.content.filter(block=>block?.type==='tool_use'||block?.type==='function').map(block=>({name:block.name||block.function?.name,arguments:parseArguments(block.input??block.arguments??block.function?.arguments)}));
+ // Strict JSON content is accepted only when the provider did not expose tool_calls.
+ if(typeof message?.content==='string'){
+  const parsed=parseArguments(message.content);
+  if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed)) return [{name:'plan_transit_journey',arguments:parsed}];
+ }
+ return [];
+}
+function parseArguments(value){
+ if(value&&typeof value==='object') return value;
+ if(typeof value!=='string'||!value.trim()) return null;
+ try{return JSON.parse(value)}catch{return null}
+}
